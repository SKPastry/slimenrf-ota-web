# Maintainer: jitingcn <jiting@jtcat.com>
# Pre-built binary package — use this if you don't want to compile from source.
pkgname=slimenrf-ota-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="SlimeNRF OTA Firmware Update Tool for SlimeVR motion trackers (pre-built)"
arch=('x86_64')
url="https://github.com/jitingcn/SlimeVR-Tracker-nRF"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'hidapi'
  'systemd-libs'
  'dbus'
)
provides=('slimenrf-ota')
conflicts=('slimenrf-ota')
# TODO: fill in release URL when published
# source=("${pkgname}-${pkgver}.tar.gz::https://github.com/...")
# sha256sums=('...')

package() {
  # Binary
  install -Dm755 "slimenrf-ota" \
    "$pkgdir/usr/bin/slimenrf-ota"

  # Desktop entry
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/slimenrf-ota.desktop" <<EOF
[Desktop Entry]
Name=SlimeNRF OTA
Comment=Firmware update tool for SlimeVR motion trackers
Exec=slimenrf-ota
Icon=slimenrf-ota
Terminal=false
Type=Application
Categories=Utility;HardwareSettings;
EOF

  # Icons
  for size in 32x32 128x128; do
    if [ -f "icons/${size}.png" ]; then
      install -Dm644 "icons/${size}.png" \
        "$pkgdir/usr/share/icons/hicolor/${size}/apps/slimenrf-ota.png"
    fi
  done

  # udev rules
  install -Dm644 "99-slimenrf.rules" \
    "$pkgdir/etc/udev/rules.d/99-slimenrf.rules"
}

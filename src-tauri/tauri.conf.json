{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SlimeNRF OTA",
  "version": "0.1.0",
  "identifier": "com.jtcat.smol-ota",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SlimeNRF OTA Updater",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com https://nightly.link; img-src 'self' https: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/99-slimenrf.rules"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/etc/udev/rules.d/99-slimenrf.rules": "resources/99-slimenrf.rules"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}

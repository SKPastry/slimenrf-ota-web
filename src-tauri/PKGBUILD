# Maintainer: jitingcn <jiting@jtcat.com>
pkgname=slimenrf-ota-git
pkgver=0.1.0
pkgrel=1
pkgdesc="SlimeNRF OTA Firmware Update Tool for SlimeVR motion trackers"
arch=('x86_64')
url="https://github.com/jitingcn/SlimeVR-Tracker-nRF"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'hidapi'
  'systemd-libs'  # libudev
  'dbus'
)
makedepends=(
  'rust'
  'cargo'
  'pnpm'
  'nodejs'
  'pkg-config'
  'git'
)
provides=('slimenrf-ota')
conflicts=('slimenrf-ota' 'slimenrf-ota-bin')
# For AUR: uncomment and set to the repo URL
# source=("${pkgname}::git+https://github.com/jitingcn/slimenrf-ota-web.git")
# sha256sums=('SKIP')

# For local development builds:
#   cd slimevr-ota-web/src-tauri && makepkg -si --skipchecksums
source=()
sha256sums=()

_project_root() {
  # If source is cloned by makepkg, use $srcdir/<pkgname>
  if [ -d "$srcdir/$pkgname" ]; then
    echo "$srcdir/$pkgname"
  else
    # Local development: PKGBUILD is in src-tauri/
    echo "$(dirname "$(realpath "$startdir/PKGBUILD")")/.."
  fi
}

build() {
  local _root="$(_project_root)"
  cd "$_root"

  # Build frontend
  pnpm install --frozen-lockfile
  pnpm build

  # Build Tauri app
  cd src-tauri
  cargo build --release
}

package() {
  local _root="$(_project_root)"
  cd "$_root"

  # Binary
  install -Dm755 "src-tauri/target/release/slimenrf-ota" \
    "$pkgdir/usr/bin/slimenrf-ota"

  # Desktop entry
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/slimenrf-ota.desktop" <<EOF
[Desktop Entry]
Name=SlimeNRF OTA
Comment=Firmware update tool for SlimeVR motion trackers
Exec=slimenrf-ota
Icon=slimenrf-ota
Terminal=false
Type=Application
Categories=Utility;HardwareSettings;
EOF

  # Icons
  install -Dm644 "src-tauri/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/slimenrf-ota.png"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/slimenrf-ota.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/slimenrf-ota.png"
  if [ -f "src-tauri/icons/icon.png" ]; then
    install -Dm644 "src-tauri/icons/icon.png" \
      "$pkgdir/usr/share/icons/hicolor/512x512/apps/slimenrf-ota.png"
  fi

  # udev rules
  install -Dm644 "src-tauri/resources/99-slimenrf.rules" \
    "$pkgdir/etc/udev/rules.d/99-slimenrf.rules"
}

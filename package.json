{
  "name": "slimenrf-ota-web",
  "version": "1.0.0",
  "description": "SlimeNRF OTA Firmware Update Tool (WebHID)",
  "private": true,
  "license": "MIT",
  "author": "Jiting",
  "homepage": "https://smol-ota.jtcat.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitingcn/slimenrf-ota-web.git"
  },
  "bugs": {
    "url": "https://github.com/jitingcn/slimenrf-ota-web/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "preview": "vite preview",
    "build": "vite build",
    "deploy": "vite build && npx wrangler pages deploy --commit-dirty=true",
    "deploy:prod": "vite build && npx wrangler pages deploy --branch production --commit-dirty=true",
    "deploy:staging": "vite build && npx wrangler pages deploy --branch staging --commit-dirty=true",
    "pages:dev": "vite build && npx wrangler pages dev"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "daisyui": "^5.5.20",
    "tailwindcss": "^4.3.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "fflate": "^0.8.3"
  }
}
